# Create two dedicated test calendars from the TestCalendar one.
calendar['TestCalendar'] > create
  | set name = Test Calendar Source

calendar['TestCalendar'] > create
  | set name = Test Calendar Target

# Populate the source calendar with five test events via a series helper.
calendar['Test Calendar Source'] > series
  | set start = 2025-12-10
  | set offsets = 0, 1, 2, 3, 4
  | set name = 'Test Event {index}'
  | set description = "Generated by DSL on {date}"
  | set recurrence = yearly
  | set reminders = 1 week, 1 day

# Select the first three events and move them to the target calendar.
calendar['Test Calendar Source'] > events
  | where name match 'Test Event [0-9]+$'
> transfer calendar['Test Calendar Target']
  | set delete_source = true

calendar['Test Calendar Source'] > events > delete
calendar['Test Calendar Target'] > events > delete